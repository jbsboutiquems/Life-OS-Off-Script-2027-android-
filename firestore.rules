rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Daily Entries Subcollection
      match /dailyEntries/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(entryId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Personality Snapshots Subcollection
      match /personalitySnapshots/{snapshotId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(snapshotId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Goals Subcollection
      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goalId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Anti-Goals Subcollection
      match /antiGoals/{antiGoalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(antiGoalId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Media Generations Subcollection (Music, Images, Videos)
      match /mediaGenerations/{mediaId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(mediaId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Chat Messages Subcollection
      match /chatMessages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
